diff --git a/src/processing/text_cleaner.py b/src/processing/text_cleaner.py
index ebecee2..bd1f7b0 100644
--- a/src/processing/text_cleaner.py
+++ b/src/processing/text_cleaner.py
@@ -454,8 +454,13 @@ def drop_empty_list_items(text: str) -> str:
       1. маркер без текста вовсе: '• ', '- ', '* ' (только пробелы после);
       2. висячее тире после маркера: '-  — ' / '- –' (потеряна переменная).
     Строки вида «— текст» (нормальный пояснительный абзац) НЕ трогает."""
-    text = re.sub(r"(?m)^[ \t]*[•\-\*][ \t]*+(?:[\u2014\u2013][ \t]*)?(?:\n|$)",
-                  "", text)
+    prev = None
+    while prev != text:
+        prev = text
+        text = re.sub(r"(?m)^[ \t]*[•\-\*](?:[ \t]+|[ \t]*[\u2014\u2013][ \t]*)(?:\n|$)",
+                      "", text)
+    # схлопнуть серию пустых строк, оставшихся после вырезания, до одной
+    text = re.sub(r"\n{3,}", "\n\n", text)
     return text
 
 
