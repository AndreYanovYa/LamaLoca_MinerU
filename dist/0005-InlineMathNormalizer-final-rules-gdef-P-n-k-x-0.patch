MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- потерянные индексы склеиваются только перед цифровым токеном с ограничителем
  конца выражения («x 0 =» → x_{0}); раньше «r n(x) = O(...)» превращалось в
  r_{n}(x)… и прозу «P n(x) имеет вид» можно было изувечить;
- новый проход: буквенный индекс ПЕРЕД явным скриптом/аргументом —
  «P n^(k)(x 0) = f^(k)(x 0)» → $P_{n}^{(k)}(x_{0}) = f^{(k)}(x_{0})$ (кейс
  пользователя, ранее молча пропускался);
- многосимвольные голые показатели: ^2n+2 → ^{2n+2} (риск O(x^n+1) vs O(x^{n+1})
  из аудита устранён — хвост показателя жадно до пробела/знака препинания);
- ^(k) → ^{(k)} вместо потери скобок (^{k});
- fix_llm_math_artifacts: удаление TeX-макросов (\gdef/\edef/\def/\newcommand…)
  ВНЕ $$-блоков — источник 'Parser Error: Undefined control sequence: \gdef';
- нормализатор вызывается на обоих уровнях: sanitize_llm_answer (ответ LLM) и
  mineru_parser._add_prose (инжест, до векторизации); clean_text не менялся;
- тесты: идемпотентность, защита готовых $...$/$$...$$, нетронутость прозы.
---
 src/processing/text_cleaner.py | 35 +++++++++++++++++++++++++++++++---
 1 file changed, 32 insertions(+), 3 deletions(-)

diff --git a/src/processing/text_cleaner.py b/src/processing/text_cleaner.py
index ee5df02..342e459 100644
--- a/src/processing/text_cleaner.py
+++ b/src/processing/text_cleaner.py
@@ -425,6 +425,15 @@ def fix_llm_math_artifacts(text: str) -> str:
             continue
         seg = re.sub(r"\\\^", "^", seg)
         seg = re.sub(r"\\_(?=[A-Za-z0-9(])", "_", seg)
+        # FIX (лог 23:xx, «Parser Error: Undefined control sequence: \gdef»):
+        # LLM иногда вставляет служебные TeX-макросы (\gdef, \edef, \def,
+        # \newcommand…) прямо в инлайн-прозу — KaTeX их не определяет и роняет
+        # весь рендер. Вне $$-блоков они всегда артефакт: снимаем бэкслэш,
+        # оставляя читаемый текст («\gdef P_n(x)» → «gdef P_n(x)»). Внутри
+        # $$-блоков макросы легальны — сегменты-формулы пропущены выше.
+        seg = re.sub(
+            r"\\(?:gdef|edef|xdef|def\b|newcommand\b|renewcommand\b|"
+            r"providecommand\b|let\b|longdef|global\b)(?![A-Za-z])", "", seg)
         parts[i] = seg
     return "".join(parts)
 
@@ -660,8 +669,24 @@ class InlineMathNormalizer:
         has_o = bool(re.search(r"(^|[\s(/+\-])[oO]\s*\(", s))
         if not (has_script or has_op or has_o):
             return None
-        # потерянные индексы: буква/цифра/скобка + пробел + токен → «x_0», «r_n»
-        s = re.sub(r"(?<=[A-Za-z0-9)\]])[ \t]+(?=[A-Za-z0-9])", "_", s)
+        # потерянные индексы (цифровой токен): буква/скобка + пробел + цифра →
+        # «x_0», «r_n» — только если за токеном конец прогона или разделитель
+        # («, ; ) (= < > ≈ ≤ ≥ ≠»). Раньше склейка шла по всему прогону:
+        # «r n(x) = O(...)» превращалось в «r_{n}(x)» (индекс стал аргументом —
+        # подмена смысла), а «P n^(k)(x 0) = f^(k)(x 0)» терял скобки у ^{(k)}.
+        s = re.sub(r"(?<=[A-Za-z0-9)\]])[ \t]+(?=\d{1,4}(?![A-Za-z0-9])(?=$|[ \t,;)=<>≈≤≥≠]))",
+                   "_", s)
+        # потерянные скрипты с явным маркером: «^ (k)» → '^{(k)}', '_ {0}' и т.п.
+        s = re.sub(r"([\^_])[ \t]+(?=[({])", r"\1", s)
+        # буквенный индекс/показатель ПЕРЕД явным скриптом или скобкой-аргументом:
+        # «P n^(k)(x 0)» → «P_n^{(k)}(x_{0})», «r n(x) = ...» → «r_n(x)».
+        # Ограничитель в конце (^_|() гарантирует: проза («P n(x) имеет вид»)
+        # не трогается — там после индекса идёт кириллица/конец слова без маркера.
+        for _ in range(3):  # цепочки «a n m^(k)» обрабатываются за пару проходов
+            new = re.sub(r"(?<=[A-Za-z0-9)\]])[ \t]+([A-Za-z])(?=[\^_]|\()", r"_\1", s)
+            if new == s:
+                break
+            s = new
         # «o (…)», «O (…)» — o-нотация: TeX-команда с пробелом («\o »),
         # KaTeX-совместимо; голые «o(x)»/«O(x^n+1)» без пробела тоже легальны,
         # но нормализуем к единому виду только при явном пробеле.
@@ -674,7 +699,11 @@ class InlineMathNormalizer:
         # скрипты в канон: ^(k)→^{(k)}, ^{n}→^{n}, ^n→^{n}, _k→_{k}
         s = re.sub(r"\^\s*\(([^()]{1,10})\)", r"^{\1}", s)
         s = re.sub(r"\^\s*\{([^{}]{1,12})\}", r"^{\1}", s)
-        s = re.sub(r"\^\s*([A-Za-z0-9])", r"^{\1}", s)
+        # многосимвольный «голый» показатель: «^2n+2», «^n+1» — жадно до
+        # границы выражения. Раньше матчался один символ → «x^{2}n+2» вместо
+        # «x^{2n+2}» (риск неверной формулы из аудита: O(x^n+1) vs O(x^{n+1})).
+        s = re.sub(r"\^\s*([A-Za-z0-9](?:[A-Za-z0-9+\-*/][A-Za-z0-9]*)*)",
+                   lambda mm: "^{" + mm.group(1) + "}", s)
         s = re.sub(r"_\s*\(([^()]{1,10})\)", r"_{(\1)}", s)
         s = re.sub(r"_(?!\{)([A-Za-z0-9])", r"_{\1}", s)
         # функции/операторы → TeX
