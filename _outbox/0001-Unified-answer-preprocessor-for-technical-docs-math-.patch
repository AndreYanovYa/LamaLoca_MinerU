+    @classmethod
+    def _open_source_static(cls, index: int):
+        """Клик по [N](source:N) из текста ответа → открыть источник N.
+
+        Индексация меток [N] в промпте — с 1 (источник №1 = sources[0]).
+        Вне диапазона — понятный snack вместо падения или битой ссылки.
+        """
+        inst = cls._instance
+        if inst is None:
+            return
+        sources = getattr(inst, "last_sources", None) or []
+        if 1 <= index <= len(sources):
+            inst._open_source(sources[index - 1])
+        else:
+            inst._snack(f"Источник [{index}] недоступен "
+                        f"(в ответе {len(sources)} источников)")
+
