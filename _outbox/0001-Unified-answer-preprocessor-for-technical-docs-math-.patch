+def _md_on_tap_link(e):
+    """Обработчик markdown-ссылок внутри текстовых блоков.
+
+    Универсальный путь для техдокументации: [N](source:N) из препроцессора
+    prepare_answer_text открывает источник/страницу в панели просмотра, а не
+    ведёт в браузер. Обычные http(s)-ссылки Flet обрабатывает сам — их сюда
+    не передают (url начинается с http), поэтому фильтруем по префиксу.
+    """
+    try:
+        url = getattr(e, "url", "") or ""
+    except Exception:
+        return
+    m = re.match(r"^source:(\d+)$", url)
+    if not m:
+        return
+    ChatView._open_source_static(int(m.group(1)))
+
+
