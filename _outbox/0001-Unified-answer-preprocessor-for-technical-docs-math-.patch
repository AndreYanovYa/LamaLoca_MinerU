+# ---------------------------------------------------------------------------
+# UNIFIED ANSWER PREPROCESSOR (универсальное решение для техдокументации:
+# математика / физика / программирование). Один конвейер, 4 стадии:
+#   1. сырой LaTeX (\( \), \[ \], \in, \to, \mathbb) -> канон $...$/$$...$$;
+#   2. вырезание дублей строк/блоков (авто-продолжение и «галлюцинации»
+#      мелких моделей: строка с LaTeX + сразу та же строка в Unicode);
+#   3. нормализация display-блоков $$...$$ (обязательные пустые строки вокруг
+#      — иначе Flet/scanner склеивают формулу с текстом и верстка разъезжается);
+#   4. битые ссылки [N] (остаточные метки страниц учебника, не связанные с UI)
+#      превращаются в кликабельные markdown-ссылки [N](source:N) — их
+#      подхватывает on_tap_link ниже и открывает страницу в панели просмотра.
+# Чистая функция над строкой: потокобезопасна, идемпотентна.
+# ---------------------------------------------------------------------------
+
+_RAW_PAREN_MATH_RE = re.compile(r"\\\((.+?)\\\)", re.DOTALL)
+_RAW_BRACKET_MATH_RE = re.compile(r"\\\[(.+?)\\\]", re.DOTALL)
+_DISPLAY_WRAP_RE = re.compile(r"(?<!\$)\$\$(?!:)")
+
+
+def _canonicalize_latex_delimiters(text: str) -> str:
+    r"""\(x\) -> $x$, \[...\] -> $$...$$; одиночные \[ /\] без пары не трогаем."""
+    text = _RAW_PAREN_MATH_RE.sub(lambda m: "$" + m.group(1) + "$", text)
+    text = _RAW_BRACKET_MATH_RE.sub(lambda m: "$$" + m.group(1) + "$$", text)
+    # маркеры {{FORMULA:N}} от ранних версий промпта — убираем молча
+    text = re.sub(r"\{\{\s*FORMULA\s*:\s*\d+\s*\}\}", "", text, flags=re.I)
+    return text
+
+
+def dedup_repeated_lines(text: str) -> str:
+    """Вырезает подряд идущие дублирующиеся строки/короткие блоки.
+
+    Две формы дублей из практики:
+      a) полная строка повторяется 2+ раза подряд (модель повторила хвост
+         предыдущей порции при авто-продолжении);
+      b) два соседних текста совпадают с точностью до математики: одна строка
+         содержит LaTeX ($x_0 \\in (a,b)$), следующая — тот же текст после
+         Unicode-конверсии (x₀ ∈ (a, b)). Сравниваем «скелеты» строк без
+         математических токенов и регистронезависимо — если скелеты равны и
+         длина > 60 символов, оставляем ЛАТЕКС-версию (она уходит в PNG-рендер,
+         т.е. показывает корректную формулу) и выбрасываем плоский дубль.
+    """
+    if not text:
+        return text
+    lines = text.split("\n")
+    out: List[str] = []
+
+    _SUBSCRIPTS = str.maketrans("₀₁₂₃₄₅₆₇₈₉", "0123456789")
+
+    def skeleton(s: str) -> str:
+        r"""Текстовый «скелет» строки без математики любого вида.
+
+        LaTeX-версия ($x_0 \in \mathbb{R}$...) и её Unicode-дубль (x₀ ∈ ℝ...)
+        после канонизации препроцессором отличаются содержимым формул, поэтому
+        из скелета вырезаются ВСЕ математические токены: пары $...$, одиночные
+        $-скобки, последовательности латиницы/цифр (в них прячутся ядра команд
+        \in→in, \forall→forall и голые переменные X/R/x0), индексы/скобки и
+        весь math-Unicode (∈∀∃ℝȮ…). Остаётся только кириллический каркас
+        предложения — он у обеих версий идентичен.
+        """
+        s = re.sub(r"\$[^$]*\$", " ", s)             # пары формул $...$
+        s = re.sub(r"\\[A-Za-z]+", " ", s)           # команды вне $ \in \to …
+        s = re.sub(r"[A-Za-z0-9]+", " ", s)          # ядра команд + переменные
+        s = s.translate(_SUBSCRIPTS)                 # x₀ → x0 (до удаления цифр)
+        s = re.sub(r"[^А-Яа-яЁё]+", "", s)           # оставляем кириллицу
+        return s.lower()
+
+    for line in lines:
+        stripped = line.strip()
+        if not stripped:
+            out.append(line)
+            continue
+        if out:
+            prev = out[-1].strip()
+            if prev == stripped:                    # форма (a): точный дубль
+                continue
+            ps, cs = skeleton(prev), skeleton(stripped)
+            if (ps and ps == cs and len(stripped) > 60
+                    and ("$" in prev) != ("$" in stripped)):
+                # форма (b): один и тот же текст дважды — LaTeX vs Unicode.
+                keep = prev if "$" in prev else stripped
+                out[-1] = keep
+                continue
+        out.append(line)
+    # схлопываем 3+ пустых строк в одну границу абзаца
+    joined = "\n".join(out)
+    joined = re.sub(r"\n{3,}", "\n\n", joined)
+    return joined
+
+
+def normalize_display_blocks(text: str) -> str:
+    """Гарантирует изоляцию $$...$$ блоков отдельными пустыми строками.
+
+    Модель пишет «...предложения. $$\\sum...$$ следующим» — без переносов
+    блок рендерится в середине строки и индексы/суммы наезжают друг на друга.
+    """
+    if not text or "$$" not in text:
+        return text
+    # защищаем содержимое code-fence блоков (```python ... ```), чтобы
+    # случайные $$ в коде не обрамлялись как формулы
+    fences: List[str] = []
+
+    def _save(m):
+        fences.append(m.group(0))
+        return "\x00F%d\x00" % (len(fences) - 1)
+
+    text = re.sub(r"```[\s\S]+?```", _save, text)
+    text = re.sub(r"([^\n])\s*(\$\$[^\n$]+\$\$)\s*", r"\1\n\n\2\n\n", text)
+    text = re.sub(r"(\$\$[^\n$]+\$\$)\s*([^\n])", r"\1\n\n\2", text)
+    text = re.sub(r"\x00F(\d+)\x00", lambda m: fences[int(m.group(1))], text)
+    return re.sub(r"\n{3,}", "\n\n", text)
+
+
+_SOURCE_CITE_RE = re.compile(r"(?<![\[\w!])\[(\d{1,3})\](?!\()")
+
+
+def linkify_source_citations(text: str) -> str:
+    """[N] → [N](source:N) — кликабельные ссылки вместо битых меток.
+
+    Уже готовые markdown-ссылки ([N](...), [^N], |page:N|) не затрагиваются:
+    lookahead (?!(\\()) пропускает их, а виджет-парсер сам решает, что чинить.
+    """
+    if not text or "[" not in text:
+        return text
+    fences: List[str] = []
+
+    def _save(m):
+        fences.append(m.group(0))
+        return "\x00C%d\x00" % (len(fences) - 1)
+
+    text = re.sub(r"```[\s\S]+?```", _save, text)
+    text = _SOURCE_CITE_RE.sub(r"[\1](source:\1)", text)
+    text = re.sub(r"\x00C(\d+)\x00", lambda m: fences[int(m.group(1))], text)
+    return text
+
+
+def prepare_answer_text(raw: str) -> str:
+    """Единый препроцессор ответа ИИ перед рендером во Flet (см. выше)."""
+    if not raw:
+        return ""
+    t = _canonicalize_latex_delimiters(raw)
+    t = dedup_repeated_lines(t)
+    t = normalize_display_blocks(t)
+    t = linkify_source_citations(t)
+    return t.strip()
+
+
