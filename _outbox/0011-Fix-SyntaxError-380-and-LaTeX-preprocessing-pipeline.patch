+        pat = (r"(?<![A-Za-z0-9\\$])(" + "|".join(sorted(map(re.escape, known))) +
+               r")(?=[_^](?![A-Za-z0-9]{2,})|\{|\^\()")
+        return re.sub(pat, lambda m: "\\" + m.group(1), s)
+
+    parts = re.split(r"(\x00W\d+\x00)", text)
+    fixed: List[str] = []
+    for p in parts:
+        m = re.fullmatch(r"\x00W(\d+)\x00", p) if p else None
+        fixed.append(fences[int(m.group(1))] if m else _restore_segment(p))
+    return "".join(fixed)
