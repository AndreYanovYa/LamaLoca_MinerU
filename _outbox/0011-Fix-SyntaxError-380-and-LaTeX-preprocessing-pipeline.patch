+def _wrap_bare_inline_commands(text: str) -> str:
+    r"""Возврат потерянного бэкслэша известным LaTeX-командам вне $...$.
+
+    Модель иногда пишет «frac{x^{3}}{3!}», «mathbfr(t)», «sum_{k=0}^n» — слэш
+    съеден токенизатором. Если перед такойknown-именом идёт `{` или `_`/`^`
+    (т.е. это явное использование команды, а не английское слово «in text»),
+    бэкслэш восстанавливается. Code-fence содержимое защищено.
+    """
+    fences: List[str] = []
+
+    def _save(m):
+        fences.append(m.group(0))
+        return "\x00W%d\x00" % (len(fences) - 1)
+
+    text = re.sub(r"```[\s\S]+?```", _save, text)
+    # целые формулы не трогаем: \sum/rac там уже со слэшем и обработаются штатно
+    text = re.sub(r"\$\$[\s\S]+?\$\$", _save, text)
+    text = re.sub(r"(?<!\\)\$(?!\$)[^$\n]+?\$", _save, text)
+
+    known = {k[1:] for k in _INLINE_MATH_MAP if k.startswith("\\")}
+    known |= {"sqrt", "text", "operatorname", "mathbf", "boldsymbol",
+              "lim", "ln", "log", "exp", "sin", "cos", "tg", "arctg"}
+
+    def _braced_cmd_repl(m):
