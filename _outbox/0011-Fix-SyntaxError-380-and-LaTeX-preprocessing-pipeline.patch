+    r"|[A-Za-z]_(?:\{[^{}]{1,14}\}|[A-Za-z0-9](?![A-Za-z0-9]))"  # прижатый индекс x_0 / x_{k=0}; НЕ log_2024
+    r"|[A-Za-z]\^\{?\(?[A-Za-z0-9]"                   # прижатая степень e^x / a^{(k)}
