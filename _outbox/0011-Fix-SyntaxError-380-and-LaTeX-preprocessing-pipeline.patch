+
+    def _restore_segment(s: str) -> str:
+        # слитое слияние имени команды со скобочным аргументом: mathbfr(t) → \mathbf{r}(t)
+        s = re.sub(r"(?<![A-Za-z0-9\\$])([a-z]{4,15})(\([^(){}$]{1,15}\))",
+                   _braced_cmd_repl, s)
