+def _normalize_math_boundaries(text: str) -> str:
+    r"""Голая инлайн-математика внутри предложений → $...$-блоки.
+
+    Срабатывает ТОЛЬКО на непрерывные прогоны математических атомов,
+    содержащие хук (прижатый индекс/степень либо backslash-команду) И
+    оператор (= < > ∈ → …). Русская проза, snake_case идентификаторы
+    («my_file.txt», «log_2024») и markdown под защиту не попадают.
+    Примеры: «r_n^{(k)}(x₀) = 0» → «$r_n^{(k)}(x₀) = 0$»;
+             «(1+x)^\alpha» → «$(1+x)^\alpha$».
+    """
+    fences: List[str] = []
+
+    def _save(m):
+        fences.append(m.group(0))
+        return "\x00M%d\x00" % (len(fences) - 1)
+
+    text = re.sub(r"```[\s\S]+?```", _save, text)
+    disp: List[str] = []
+
+    def _save_d(m):
+        disp.append(m.group(0))
+        return "\x00D%d\x00" % (len(disp) - 1)
+
+    text = re.sub(r"\$\$[^$]+?\$\$", _save_d, text, flags=re.DOTALL)
+    text = re.sub(r"(?<!\\)\$(?!\$)[^$\n]+?\$", _save_d, text)
+
+    proto = rf"(?:{_MATH_ATOM}{{2,}})"
+
+    def _repl(m):
+        tok = m.group(0)
+        core = tok.strip().strip("[](){}.,;:")
+        if not core or len(core) < 4:
+            return tok
+        if not _MATH_START.match(core):
+            return tok                     # начинается со слова — проза
+        if re.search(r"\s[A-Za-zА-Яа-яЁё]{2,}$", core):
+            return tok                     # тянет за собой слово — проза
+        if not _MATH_HOOK.search(core):
+            return tok                     # нет индекса/степени/команды — проза
+        if not re.search(r"[=<>≤≥≠≈∈→⇒∑∫]", core):
+            return tok                     # нет оператора — не уравнение
+        lead_ws = tok[:len(tok) - len(tok.lstrip())]
+        trail_ws = tok[len(tok.rstrip()):]
+        return f"{lead_ws}${core}${trail_ws}"
+
+    text = re.sub(proto, _repl, text)
+
+    text = re.sub(r"\x00D(\d+)\x00", lambda m: disp[int(m.group(1))], text)
+    text = re.sub(r"\x00M(\d+)\x00", lambda m: fences[int(m.group(1))], text)
+    return text
+
