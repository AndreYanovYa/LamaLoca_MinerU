+# ---------------------------------------------------------------------------
+# ПАТЧ 0010/0011: нормализация ГРАНИЦ инлайн-математики.
+# Диагноз со скриншотов: display-блоки ($$...$$) рендерятся идеально, но
+# формулы, зашитые внутрь абзацев/списков, доживают до ft.Markdown сырыми:
+#   * «r_n^{(k)}(x₀) = 0», «(e^x)^{(n)} = e^x», «(1+x)^\alpha» — голые ^/_
+#     без $-обёртки;
+#   * «где P_n(x) = \sum_{k=0}^n a_k» — команда \sum посреди текста;
+#   * «mathbfr(t)», «frac x^3 3!» — модель/препроцессоры съели бэкслэш, и
+#     LaTeX-имена команд слились с аргументами в одно слово.
+# Чинится ДО конверсии в Unicode: непрерывные математические прогоны внутри
+# предложений оборачиваются в $...$, после чего существующий конвейер
+# (_latex_inline_to_unicode / PNG-путь) обрабатывает их штатно.
+# ---------------------------------------------------------------------------
+
+# Атом формулы: команда (в т.ч. с {аргументом}/_подстрокой/^надстрок),
+# переменная с индексом/степенью, скобочная группа, оператор, число, слово.
+_MATH_ATOM = (
+    r"(?:\\[A-Za-z]+(?:\s*\{[^{}]*\}){0,2}(?:[_^]\{?[A-Za-z0-9()]+\}?)*"  # \frac{x}{3!}, \sum_{k=0}^n
+    r"|[A-Za-z](?:_\{?[A-Za-z0-9]\}?|\^\{[^{}]{1,12}\}|\^\{?\(?[A-Za-z0-9]+\)?\}?)"  # x_0, a^n, f^{(k)}, e^x
+    r"|\^\{[^{}]*\}|_\{[^{}]*\}"                                   # ^{(k)}, _{k=0}
+    r"|_(?![A-Za-z0-9]{2})"                                        # одиночный «_» индекса (r_n), НЕ my_file/log_2024
+    r"|\(|\)|\[|\]|=|<|>|≤|≥|≠|≈|→|∈|∉|⊂|∪|∩|∀|∃|∑|∏|∫|\+|\-|\*|/|;|:"
+    r"|,\s\d+(?:[.,]\d+)?"                                         # «, 0» — аргумент функции
+    r"|\s\d+(?:[.,]\d+)?"                                          # « 0» — число после оператора
+    r"|\w[\w.]*|[A-Za-z])"                                         # слово/число целиком / одиночная буква
