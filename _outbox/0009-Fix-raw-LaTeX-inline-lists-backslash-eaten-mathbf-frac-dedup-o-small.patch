+def _apply_scripts(s: str) -> str:
+    """Индексы/степени LaTeX-нотации → Unicode: x_0→x₀, (x−x₀)^n→(x−x₀)ⁿ,
+    a^{10}→a¹⁰, f^(k)→f(k) (скобочная степень читается как производная)."""
