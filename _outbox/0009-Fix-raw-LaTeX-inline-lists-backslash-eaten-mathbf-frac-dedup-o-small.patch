+def _skeleton(s: str) -> str:
+    r"""Текстовый «скелет» строки без математики любого вида.
+
+    LaTeX-версия ($x_0 \in \mathbb{R}$...) и её Unicode-дубль (x₀ ∈ ℝ...)
+    отличаются содержимым формул, поэтому из скелета вырезаются ВСЕ
+    математические токены: пары $...$, команды, латинские слова/переменные,
+    индексы-юникод. Цифры удаляются ТОЛЬКО прижатые к не-кириллическим
+    символам или стоящие после пробела в окружении латиницы/знаков — номера
+    формул и страниц («Теорема 13.2», «стр. 295»), закреплённые за русскими
+    словами, остаются частью каркаса. Остаётся кириллический каркас с
+    цифровыми метками — он у обеих версий дубля идентичен.
+    """
+    # FIX (неполная дедупликация): предварительная нормализация — обе версии
+    # дубля (LaTeX «x_0 \in» и Unicode «x₀ ∈», «x 0») приводятся к одному
+    # виду ДО выреза математики; иначе скелеты расходились на OCR-разрывах.
+    s = s.translate(_SUBSCRIPTS_TR)                   # x₀ → x0
+    s = re.sub(r"_\s*\{?\s*(\d{1,3})\s*\}?", r"\1", s)   # x_0 / x^{0} → x0
+    s = re.sub(r"(?<=[A-Za-z0-9]) \s(?=\d\b)", "", s)      # «x 0» → «x0»
+    s = re.sub(r"\$[^$]*\$", " ", s)                 # пары формул $...$
+    s = re.sub(r"\\[A-Za-z]+", " ", s)               # команды вне $ \in \to …
+    s = re.sub(r"[A-Za-z][A-Za-z0-9]*", " ", s)      # латинские слова/ядра/переменные
+    s = re.sub(r"[A-Za-z0-9]+", " ", s)              # прилипшие к знакам цифры (x0→ уже убран)
+    # цифры, НЕ стоящие сразу после кириллицы/пробела+кириллицы-слова — мусор;
+    # «13.2» после «Теорема » остаётся.
+    s = re.sub(r"(?<![А-Яа-яЁё])\d+(?:[.,]\d+)*", " ", s)
+    s = re.sub(r"[^А-Яа-яЁё0-9.,]+", " ", s)         # каркас: кириллица + метки
+    s = re.sub(r"\s{2,}", " ", s).strip().lower()
+    return s
