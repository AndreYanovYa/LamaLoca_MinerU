++                except (ValueError, TypeError):
++                    try:
++                        parsed = json.loads(s.replace("'", '"'))
++                    except (ValueError, TypeError):
++                        parsed = None
++            trimmed.append(parsed if isinstance(parsed, dict) else {})
+ 
+         def _total() -> int:
+             return self.estimate_tokens(trimmed)
