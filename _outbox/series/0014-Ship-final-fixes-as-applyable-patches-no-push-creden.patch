++            # импортов): dict — passthrough, str/bytes — json.loads, мусор — {}.
++            if isinstance(m, dict):
++                trimmed.append(dict(m))
++                continue
++            parsed: Any = None
++            if isinstance(m, (bytes, bytearray)):
++                m = m.decode("utf-8", errors="replace")
++            if isinstance(m, str):
++                s = m.strip()
