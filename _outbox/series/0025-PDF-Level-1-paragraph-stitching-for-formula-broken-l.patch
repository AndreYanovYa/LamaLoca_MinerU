++++ b/src/ingestion/pdf_parser.py
+@@ -189,39 +189,37 @@ class PDFParser(BaseParser):
+     def _extract_page_blocks(self, page: pymupdf.Page, page_num: int, start_block_id: int) -> list:
+         """Извлекает блоки со страницы в РЕЖИМЕ БЛОЧНОЙ СБОРКИ (Level 1 ТЗ).
+ 
+-        FIX (разрыв формул и индексов): раньше использовался dict-обход с
+-        TEXT_PRESERVE_WHITESPACE, где each span жил отдельно — верхние/нижние
+-        индексы и разнесённые по baseline фрагменты формул PyMuPDF резал на
+-        отдельные «строки», которые затем склеивались в кашу. Теперь страница
+-        собирается методом get_text("blocks") — фреймворк сам группирует
+-        строки в логические текстовые блоки по геометрической близости, и
+-        формула остаётся монолитной.
+-
+-        Если блок содержит встроенную сложную графику (изображения-формулы,
+-        type==1) или его текст не читается (OCR-мусор/сплющенные формулы),
+-        активируется ленивый рендер зоны блока в PNG через page_renderer
+-        (src/ingestion/page_renderer.py) — как заложено архитектурой проекта.
++        Пайплайн извлечения (универсальный, для Математики/Физики/Кода):
++        1. page.get_text("blocks", TEXT_PRESERVE_WHITESPACE) — структурная
++           группировка строк по геометрии страницы.
++        2. _merge_paragraphs() — доклейка блоков-продолжений: если PyMuPDF
++           разбил один абзац на несколько геометрических блоков (висячая
++           последняя строка, обрыв перед встроенной формулой), они
++           объединяются обратно в единый логический абзац.
++        3. _stitch_block() — нормализация: принудительные \n внутри блока
++           (возникают из-за встроенных формул, ∀/∃/∈, индексов) заменяются
++           пробелами; дефисные переносы слов склеиваются; математические
++           глифы получают защитные пробели и не слипаются со словами.
++        4. Ленивый PNG (page_renderer) — для зон со сплющенной графикой.
+         """
+-        blocks = []
+-        # --- Level 1: блочная сборка вместо span-level dict-обхода ---
+         raw_blocks = page.get_text("blocks", flags=pymupdf.TEXT_PRESERVE_WHITESPACE)
++        # tuple -> list, отбрасываем чисто графические блоки (type==1).
++        parsed = [list(rb)[:7] for rb in raw_blocks if rb[6] != 1 and (rb[4] or "").strip()]
++        merged = self._merge_paragraphs(parsed)
+         img_zones = self._image_zones(page)
+ 
+-        for block_idx, rb in enumerate(raw_blocks):
+-            # rb: (x0, y0, x1, y1, text, block_no, block_type)
+-            x0, y0, x1, y1, text, _bno, btype = rb[:7]
+-            if btype == 1:  # чистое изображение — зона обработана ниже
+-                continue
+-
+-            block_text = re.sub(r"\n{3,}", "\n\n", (text or "").strip())
++        blocks = []
++        for idx, mb in enumerate(merged):
++            x0, y0, x1, y1, text, _bno, _btype = mb
++            block_text = self._stitch_block(text or "")
+             if not block_text:
+                 continue
+ 
+             coordinates = {"x0": round(x0, 2), "y0": round(y0, 2),
+                            "x1": round(x1, 2), "y1": round(y1, 2)}
+ 
+-            # Блочный режим даёт группы строк; заголовок — короткий блок с
+-            # большой высотой строки (эвристика bbox вместо span.size).
++            # Заголовок — короткий блок с большой высотой строки
++            # (эвристика bbox вместо span.size).
+             block_type = self._classify_bbox_block(block_text, y1 - y0)
+ 
+             method = "pymupdf_blocks"
+@@ -229,12 +227,12 @@ class PDFParser(BaseParser):
+             # Сложная графика/формулы внутри или рядом с блоком → ленивый PNG.
+             if self._block_has_math_garbage(block_text) or \
+                     self._zone_intersects(img_zones, (x0, y0, x1, y1)):
+-                zone_png = self._render_zone_lazy(page, (x0, y0, x1, y1), page_num, block_idx)
++                zone_png = self._render_zone_lazy(page, (x0, y0, x1, y1), page_num, idx)
+                 if zone_png is not None:
+                     method = "pymupdf_blocks+zone_png"
+ 
+             blocks.append(DocumentBlock(
+-                block_id=f"b{start_block_id + block_idx}",
++                block_id=f"b{start_block_id + idx}",
+                 block_type=block_type,
+                 text=block_text,
+                 page_number=page_num + 1,
+@@ -245,7 +243,7 @@ class PDFParser(BaseParser):
+                 # PNG-копия «каши» идёт отдельным блоком: векторный поиск
+                 # по тексту остаётся, а зрительный слой доступен viewer'у.
+                 blocks.append(DocumentBlock(
+-                    block_id=f"b{start_block_id + block_idx}z",
++                    block_id=f"b{start_block_id + idx}z",
+                     block_type=BlockType.FIGURE,
+                     text="",
+                     page_number=page_num + 1,
+@@ -254,9 +252,83 @@ class PDFParser(BaseParser):
+                 ))
+         return blocks
