++            block_text = re.sub(r"\n{3,}", "\n\n", (text or "").strip())
++            if not block_text:
+                 continue
+-            
++
++            coordinates = {"x0": round(x0, 2), "y0": round(y0, 2),
++                           "x1": round(x1, 2), "y1": round(y1, 2)}
++
++            # Блочный режим даёт группы строк; заголовок — короткий блок с
++            # большой высотой строки (эвристика bbox вместо span.size).
++            block_type = self._classify_bbox_block(block_text, y1 - y0)
++
++            method = "pymupdf_blocks"
++            zone_png = None
++            # Сложная графика/формулы внутри или рядом с блоком → ленивый PNG.
