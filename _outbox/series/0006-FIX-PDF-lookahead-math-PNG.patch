+# они тоже изолируются в PNG (ТЗ п.1: прямой запрет write()/cell() для ∀ ∃ ∈ …).
+_BARE_MATH_CHARS = "\u2200\u2203\u2204\u2208\u2209\u220b\u2282\u2286\u2283\u2287" \
+                   "\u222a\u2229\u2205\u2216\u2227\u2228\u00ac\u2192\u21d2\u21d4" \
