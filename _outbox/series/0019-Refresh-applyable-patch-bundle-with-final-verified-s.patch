++-            block_text, block_type = self._classify_text_block(block)
++-            if not block_text.strip():
+++
+++            block_text = re.sub(r"\n{3,}", "\n\n", (text or "").strip())
+++            if not block_text:
++                 continue
++-            
+++
+++            coordinates = {"x0": round(x0, 2), "y0": round(y0, 2),
